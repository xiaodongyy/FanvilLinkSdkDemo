<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_not_initialized"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/userIdInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1967770215329169410"
            android:hint="@string/hint_user_id"
            android:inputType="text" />

        <EditText
            android:id="@+id/agoraIdInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="200000763"
            android:hint="@string/hint_agora_id"
            android:inputType="text" />

        <EditText
            android:id="@+id/agoraAppIdInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="c585a46adf8e42c79019db1c177716da"
            android:hint="@string/hint_agora_app_id"
            android:inputType="text" />

        <EditText
            android:id="@+id/accessTokenInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_access_token"
            android:text="bacffb5f6dcd4a1daec97a365b3c5ba8"
            android:inputType="text" />

        <EditText
            android:id="@+id/mqttUrlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_mqtt_url"
            android:text="ssl://testfcms.fanvil.com:8883"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/mqttUserInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_mqtt_user"
            android:text="APP_1967770215329169410"
            android:inputType="text" />

        <Button
            android:id="@+id/initButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_init_sdk" />

        <EditText
            android:id="@+id/sipUsernameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_sip_username"
            android:text="100002007"
            android:inputType="text" />

        <FrameLayout
            android:id="@+id/rtcView"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="8dp"
            android:background="#202020" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/callButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_call" />

            <Button
                android:id="@+id/monitorButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_monitor" />

            <Button
                android:id="@+id/acceptButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_accept" />

            <Button
                android:id="@+id/endButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ToggleButton
                android:id="@+id/muteButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textOff="@string/mute_off"
                android:textOn="@string/mute_on" />

            <ToggleButton
                android:id="@+id/speakerButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:textOff="@string/speaker_off"
                android:textOn="@string/speaker_on" />
        </LinearLayout>

        <EditText
            android:id="@+id/macInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_mac"
            android:text="0c383e61e25f"
            android:inputType="text" />

        <Button
            android:id="@+id/openDoorButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_open_door" />
    </LinearLayout>
</ScrollView>
